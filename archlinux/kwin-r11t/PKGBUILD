# Maintainer: R11T Arch Linux port <lmv600vm@gmail.com>
#
# Derived from the official Arch Linux extra/kwin PKGBUILD (kwin 6.8.0-1).
# Changes against upstream:
#   * arch=(aarch64) - this package is built for the OPPO R11T port
#   * pkgrel 1.1 so the locally patched build sorts above the repo package
#   * the DRM atomic-commit EBUSY retry patch is applied in prepare()
#   * the QPA logical DPI is derived from the physical panel geometry in prepare()
#   * libcap is declared explicitly because KWin's install step runs setcap
#
# The KWin source tarball is architecture independent, so the upstream
# sha256 and build flags are kept unchanged.

pkgname=kwin
pkgver=6.8.0
_dirver=$(echo $pkgver | cut -d. -f1-3)
pkgrel=1.1
pkgdesc='An easy to use, but flexible, Wayland compositor'
arch=(aarch64)
url='https://kde.org/plasma-desktop/'
license=(LGPL-2.0-or-later)
depends=(aurorae
         breeze
         glibc
         iio-sensor-proxy
         plasma-activities
         kauth
         kcmutils
         kcolorscheme
         kconfig
         kcoreaddons
         kcrash
         kdbusaddons
         kdeclarative
         kdecoration
         kglobalaccel
         kglobalacceld
         kguiaddons
         ki18n
         kidletime
         kirigami
         kitemmodels
         knewstuff
         knighttime
         knotifications
         kpackage
         kquickcharts
         krunner
         kscreenlocker
         kservice
         ksvg
         kwayland
         kwidgetsaddons
         kwindowsystem
         kxmlgui
         lcms2
         libcanberra
         libdisplay-info
         libdrm
         libei
         libepoxy
         libevdev
         libgcc
         libinput
         libpipewire
         libqaccessibilityclient-qt6
         libstdc++
         libxcb
         libxcvt
         libxkbcommon
         mesa
         milou
         pipewire-session-manager
         libplasma
         qt6-5compat
         qt6-base
         qt6-declarative
         qt6-svg
         qt6-tools
         systemd-libs
         vulkan-icd-loader
         wayland
         xcb-util-keysyms
         xcb-util-wm)
makedepends=(extra-cmake-modules
             kdoctools
             krunner
             libcap
             plasma-wayland-protocols
             python
             vulkan-headers
             wayland-protocols
             xorg-xwayland)
optdepends=('plasma-keyboard: virtual keyboard')
groups=(plasma)
source=(https://download.kde.org/stable/plasma/$_dirver/$pkgname-$pkgver.tar.xz
        0001-kwin-drm-EBUSY-retry-on-next-vblank.patch
        0003-kwin-qpa-use-panel-physical-dpi.patch)
sha256sums=('4bfaf31e29a8f9fdf231dc3bbb9b09b0ce07cae9fee7a01cfc86425ece796258'
            'b7f7fbd87fda9524ef247f1f244541670cd2a092937e89855dafc85c2ad0dc09'
            '2d19e328ca7c54bc2c66da26195bef9ab16e60d2e297a4d68f94da0d1c2b1111')

prepare() {
  patch -d "$pkgname-$pkgver" -p1 -i "$srcdir/0001-kwin-drm-EBUSY-retry-on-next-vblank.patch"
  patch -d "$pkgname-$pkgver" -p1 -i "$srcdir/0003-kwin-qpa-use-panel-physical-dpi.patch"
}

build() {
  # Control the debug symbols shipped in the package: emit no debug info
  # (-g0).  Debug data embeds the build path ($srcdir), which makepkg
  # flags as "Package contains reference to $srcdir" on the kwin
  # executables.  The flags are appended after any -g that may come
  # from the builder image's makepkg.conf, so -g0 wins.
  export CFLAGS="$CFLAGS -g0"
  export CXXFLAGS="$CXXFLAGS -g0"
  export LDFLAGS="$LDFLAGS -g0"

  cmake -B build -S "$pkgname-$pkgver" \
    -DKDE_INSTALL_LIBEXECDIR=lib \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  # Arch packaging can drop xattrs written by the CMake install script. Set the
  # capability again on the staged binary so the r11 package is self-contained.
  setcap CAP_SYS_NICE=+ep "$pkgdir"/usr/bin/kwin_wayland
}
