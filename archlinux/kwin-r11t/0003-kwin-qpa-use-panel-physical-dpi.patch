+static QDpi outputDpi(const LogicalOutput *output)
+{
+    const int forced = forcedDpi();
+    if (forced > 0) {
+        qCInfo(KWIN_QPA) << "Using forced logical DPI" << forced;
+        return QDpi(forced, forced);
+    }
+
+    if (Q_UNLIKELY(!output)) {
+        qCInfo(KWIN_QPA) << "No output available for logical DPI, using 96";
+        return QDpi(96, 96);
+    }
+
+    const QSize physicalSize = output->physicalSize();
+    const QSize pixelSize = output->modeSize();
+    if (physicalSize.width() <= 0 || physicalSize.height() <= 0 || pixelSize.isEmpty()) {
+        qCInfo(KWIN_QPA) << "Invalid output geometry for logical DPI"
+                         << physicalSize << pixelSize << ", using 96";
+        return QDpi(96, 96);
+    }
+
+    const qreal diagonalPixels = std::hypot(qreal(pixelSize.width()), qreal(pixelSize.height()));
+    const qreal diagonalInches = std::hypot(qreal(physicalSize.width()), qreal(physicalSize.height())) / 25.4;
+    const int computedDpi = std::lround(diagonalPixels / diagonalInches);
+    if (computedDpi < 48 || computedDpi > 1000) {
+        qCInfo(KWIN_QPA) << "Computed logical DPI out of range" << computedDpi << ", using 96";
+        return QDpi(96, 96);
+    }
+    qCInfo(KWIN_QPA) << "Computed logical DPI from physical panel"
+                     << physicalSize << pixelSize << "=>" << computedDpi;
+    return QDpi(computedDpi, computedDpi);
+}
