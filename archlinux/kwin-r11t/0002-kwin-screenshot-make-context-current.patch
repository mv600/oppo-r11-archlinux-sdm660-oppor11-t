diff --git a/src/plugins/screenshot/screenshotlayer.cpp b/src/plugins/screenshot/screenshotlayer.cpp
index 1f0cc35..7e239d4 100644
--- a/src/plugins/screenshot/screenshotlayer.cpp
+++ b/src/plugins/screenshot/screenshotlayer.cpp
@@ -4,6 +4,8 @@
     SPDX-License-Identifier: GPL-2.0-or-later
 */
 #include "screenshotlayer.h"
+#include "opengl/eglcontext.h"
+#include "opengl/glframebuffer.h"
 
 namespace KWin
 {
@@ -26,6 +28,14 @@ FormatModifierMap ScreenshotLayer::supportedDrmFormats() const
 
 std::optional<OutputLayerBeginFrameInfo> ScreenshotLayer::doBeginFrame()
 {
+    // effects that run during the scene's prePaint can switch the current OpenGL
+    // context (in particular QML based effects like showfps, whose offscreen
+    // quick scene makes its own context current and then calls doneCurrent),
+    // so the context has to be made current again before rendering into the target
+    if (!m_buffer->context()->makeCurrent()) {
+        return std::nullopt;
+    }
+
     return OutputLayerBeginFrameInfo{
         .renderTarget = RenderTarget(m_buffer),
         .repaint = Region::infinite(),
