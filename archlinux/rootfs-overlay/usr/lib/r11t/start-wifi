#!/bin/sh
set -eu

modprobe ath10k_core

mss=
for retry in $(seq 1 100); do
	for remoteproc in /sys/class/remoteproc/remoteproc*; do
		[ -r "$remoteproc/name" ] || continue
		case "$(cat "$remoteproc/name")" in
			*4080000*|*mss*|*modem*) mss=$remoteproc; break ;;
		esac
	done
	[ -n "$mss" ] && break
	sleep 0.1
done
[ -n "$mss" ] || { echo 'MSS remoteproc did not register' >&2; exit 1; }

state=$(cat "$mss/state")
[ "$state" != offline ] || echo start > "$mss/state"

# OPPO R11T stock NV partition (oppodycnvbk = GPT slot p1, fixed) holds the
# factory WLAN MAC at offset 0xBCEFC, 6 bytes stored in reversed order.
read_nv_mac() {
	dev=/dev/block/mmcblk0p1
	[ -r "$dev" ] || return 1
	mac=$(dd if="$dev" bs=1 skip=$((0xBCEFC)) count=6 2>/dev/null | od -An -tx1 | tr -d ' \n')
	[ ${#mac} -eq 12 ] || return 1
	# bytes on disk are in reversed order -> un-reverse below
	mac="${mac:10:2}:${mac:8:2}:${mac:6:2}:${mac:4:2}:${mac:2:2}:${mac:0:2}"
	echo "$mac" | tr '[:lower:]' '[:upper:]'
}

# Pass the factory MAC to ath10k_snoc at modprobe time: the wcn3990 QMI
# handshake (qmi.c mac_pton) consumes the module parameter during probe,
# so writing it after wlan0 exists is too late.
mac=$(read_nv_mac || true)
if [ -n "$mac" ]; then
	modprobe ath10k_snoc mac_addr="$mac"
else
	echo 'WLAN MAC read from NV partition failed; loading with random MAC' >&2
	modprobe ath10k_snoc
fi

for retry in $(seq 1 300); do
	if [ -r /sys/class/net/wlan0/address ] && { [ -z "$mac" ] || \
	   [ "$(cat /sys/class/net/wlan0/address)" = "$mac" ]; }; then
		exit 0
	fi
	sleep 0.1
done
echo 'wlan0 did not register with the factory MAC' >&2
exit 1
