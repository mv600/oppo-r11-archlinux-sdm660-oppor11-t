[Unit]
Description=Grow OPPO R11T Btrfs root to the userdata partition
After=local-fs.target
Before=r11t-hardware.target

[Service]
Type=oneshot
# No ConditionPathExists marker.  The marker used to live in /var/lib/r11t-state,
# which is deliberately on the `cache` partition so boot-image backups survive a
# rootfs reflash -- which meant a reflash of userdata restored an 8 GiB btrfs
# while the "already grown" flag stayed behind on cache, and systemd then skipped
# this unit forever.  `btrfs filesystem resize max /` is idempotent and costs
# milliseconds when the filesystem is already at full size, so it just runs.
ExecStart=/usr/bin/btrfs filesystem resize max /

[Install]
WantedBy=multi-user.target
