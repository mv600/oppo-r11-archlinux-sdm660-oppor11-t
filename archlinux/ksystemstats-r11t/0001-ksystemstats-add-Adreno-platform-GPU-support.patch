--- a/plugins/gpu/LinuxBackend.cpp
+++ b/plugins/gpu/LinuxBackend.cpp
@@ -12,6 +12,7 @@
 
 #include <processcore/gpu_utils.h>
 
+#include "LinuxAdrenoGpu.h"
 #include "LinuxAmdGpu.h"
 #include "LinuxIntelGpu.h"
 #include "LinuxNvidiaGpu.h"
@@ -97,6 +98,39 @@
     }
 
     udev_enumerate_unref(enumerate);
+
+    enumerate = udev_enumerate_new(m_udev);
+    udev_enumerate_add_match_subsystem(enumerate, "platform");
+    udev_enumerate_add_match_property(enumerate, "DRIVER", "adreno");
+    udev_enumerate_scan_devices(enumerate);
+
+    devices = udev_enumerate_get_list_entry(enumerate);
+    for (auto entry = devices; entry; entry = udev_list_entry_get_next(entry)) {
+        auto path = udev_list_entry_get_name(entry);
+        auto platformDevice = udev_device_new_from_syspath(m_udev, path);
+        if (!platformDevice) {
+            continue;
+        }
+
+        auto sysname = QString::fromLocal8Bit(udev_device_get_sysname(platformDevice));
+        auto devfreqPath = QStringLiteral("/sys/class/devfreq/%1").arg(sysname);
+        if (!QFileInfo::exists(devfreqPath % QStringLiteral("/gpu_busy_percent"))) {
+            qCWarning(KSYSTEMSTATS_GPU) << "Adreno GPU has no busy-percent devfreq attribute:" << sysname;
+            udev_device_unref(platformDevice);
+            continue;
+        }
+
+        auto gpuId = QStringLiteral("gpu%1").arg(gpuNumber);
+        auto gpu = new LinuxAdrenoGpu(gpuId, QStringLiteral("Adreno GPU"), devfreqPath);
+        gpu->initialize();
+        m_devices.append(gpu);
+        Q_EMIT deviceAdded(gpu);
+        gpuNumber++;
+
+        udev_device_unref(platformDevice);
+    }
+
+    udev_enumerate_unref(enumerate);
 }
 
