#!/bin/busybox sh
set -eu

/bin/busybox --install -s /bin
mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys

resolve_userdata() {
	for retry in $(seq 1 150); do
		for b in /sys/class/block/mmcblk*p*; do
			[ -r "$b/uevent" ] || continue
			partname=$(sed -n 's/^PARTNAME=//p' "$b/uevent")
			[ "$partname" = userdata ] || continue
			printf '/dev/%s\n' "${b##*/}"
			return 0
		done
		sleep 0.1
	done
	return 1
}

emergency_shell() {
	echo "Arch root mount failed: $*" >&2
	mount -t configfs configfs /sys/kernel/config 2>/dev/null || true
	g=/sys/kernel/config/usb_gadget/r11t-rescue
	mkdir -p "$g/strings/0x409" "$g/configs/c.1/strings/0x409"
	echo 0x18d1 > "$g/idVendor"
	echo 0xd004 > "$g/idProduct"
	echo r11t-root-failure > "$g/strings/0x409/serialnumber"
	echo OPPO > "$g/strings/0x409/manufacturer"
	echo 'R11T root mount failure' > "$g/strings/0x409/product"
	echo 'Emergency ACM console' > "$g/configs/c.1/strings/0x409/configuration"
	mkdir -p "$g/functions/acm.usb0"
	[ -e "$g/configs/c.1/acm.usb0" ] || \
		ln -s "$g/functions/acm.usb0" "$g/configs/c.1/acm.usb0"
	set -- /sys/class/udc/*
	[ -e "$1" ] && echo "${1##*/}" > "$g/UDC"
	while [ ! -e /dev/ttyGS0 ]; do sleep 1; done
	stty -F /dev/ttyGS0 raw -echo
	exec setsid sh -c 'exec sh < /dev/ttyGS0 > /dev/ttyGS0 2>&1'
}

ROOT_DEV=$(resolve_userdata) || emergency_shell 'userdata partition not found'
mkdir -p /newroot
mount -t btrfs -o rw,noatime,compress=zstd:3,space_cache=v2,subvol=@ \
	"$ROOT_DEV" /newroot || emergency_shell "cannot mount $ROOT_DEV subvol=@"
[ -x /newroot/sbin/init ] || emergency_shell '/sbin/init is missing'

# ---------------------------------------------------------------------------
# 尽早抢救上一 boot 的 pstore(ramoops) 记录。
# ramoops 的 console 区是本 boot 内核一开始就往里写的小环形缓冲，等到用户态
# 的 r11t-pstore-save.service 跑起来（约 67 秒）时上一 boot 的尾部早已被覆盖。
# 这里在 switch_root 之前（约 1 秒）就把它拷到 rootfs 上，尽量保住上一 boot
# 死亡前的最后输出。全部 best-effort：任何一步失败都不影响启动。
# ---------------------------------------------------------------------------
pstore_rescue() {
	mkdir -p /sys/fs/pstore 2>/dev/null || true
	# 已挂载时这条会失败，无副作用
	mount -t pstore pstore /sys/fs/pstore 2>/dev/null || true
	[ -d /sys/fs/pstore ] || return 0
	ls -A /sys/fs/pstore 2>/dev/null | grep -q . || return 0

	# /var/log is a separate btrfs subvolume (@var_log) in the installed
	# system.  Writing under the @ subvolume here would be hidden as soon as
	# systemd mounts @var_log on /var/log.  Mount the real target first.
	rescue_log=/newroot/var/log
	rescue_base=$rescue_log/pstore
	mkdir -p "$rescue_log" 2>/dev/null || true
	if ! mountpoint -q "$rescue_log" 2>/dev/null; then
		if ! mount -t btrfs -o rw,noatime,compress=zstd:3,space_cache=v2,subvol=@var_log \
			"$ROOT_DEV" "$rescue_log" 2>/dev/null; then
			# Keep the fallback visible after systemd mounts @var_log on
			# /var/log.  /var/lib is part of the @ subvolume.
			rescue_base=/newroot/var/lib/r11t-pstore
			echo ">>> r11t: WARNING: cannot mount @var_log; pstore falls back to /var/lib/r11t-pstore" > /dev/kmsg 2>/dev/null || true
		fi
	fi

	ts=$(date +%Y%m%d-%H%M%S 2>/dev/null) || ts=unknown
	dir=$rescue_base/early-$ts
	if [ -e "$dir" ]; then
		dir=$dir-$$
	fi
	if mkdir -p "$dir" 2>/dev/null; then
		cp -a /sys/fs/pstore/. "$dir"/ 2>/dev/null || true
		sync 2>/dev/null || true
		echo ">>> r11t: pstore rescued to $dir early in boot" > /dev/kmsg 2>/dev/null || true
	fi

	# 只保留最近 8 份 early-*
	n=0
	for d in $(ls -1dt "$rescue_base"/early-* 2>/dev/null); do
		n=$((n + 1))
		[ "$n" -gt 8 ] && rm -rf "$d" 2>/dev/null || true
	done
	return 0
}
pstore_rescue || true

mkdir -p /newroot/dev /newroot/proc /newroot/sys
mount --move /dev /newroot/dev
mount --move /proc /newroot/proc
mount --move /sys /newroot/sys
exec switch_root /newroot /sbin/init
